# These values configure a separate, approved WEB plan-usage client.
# Do not copy the identity-only client ID returned by Sites get_site.
CHATGPT_PLAN_CLIENT_ID=
CHATGPT_PLAN_WEB_APPROVED=false
# Set only if OpenAI registers a confidential client (client_secret_basic).
CHATGPT_PLAN_CLIENT_SECRET=
# 32 random bytes encoded as base64url; configure as a Sites runtime secret.
AI_TOKEN_KEY=
